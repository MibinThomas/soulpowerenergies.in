# Soul Power Energies Environment Configuration

# Public Site URL (Used for Canonical URLs & OpenGraph Metadata)
NEXT_PUBLIC_SITE_URL=https://soulpowerenergies.in

# Resend API Key for Contact Form Email Delivery
# Sign up at https://resend.com to generate your API key
RESEND_API_KEY=

# Email inbox to receive validated lead notifications
CONTACT_NOTIFICATION_EMAIL=info@soulpowerenergies.in

# Google Analytics 4 measurement ID (gtag.js)
# Falls back to the production property when unset; set to empty to disable tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Q1SMZX3HJB
